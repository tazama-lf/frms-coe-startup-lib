STARTUP_TYPE='nats'
NODE_ENV=
SERVER_URL=
NATS_AUTHENTICATED=false
NATS_CERTIFICATE_AUTHORITY_PATH=
NATS_CLIENT_KEY_PATH=
NATS_CLIENT_CERT_PATH=
FUNCTION_NAME=
# Optional: default publish destination for handleResponse when no explicit subject is supplied.
PRODUCER_STREAM=
CONSUMER_STREAM=
SERVICE_CHANNEL_PRODUCER=
SERVICE_CHANNEL_CONSUMER=
SERVICE_CHANNEL_SOURCE_URI_PREFIX=

# Optional downstream NATS relay connection (TLS settings are independent of SERVER_URL).
DESTINATION_TYPE=nats
DESTINATION_URL=
DESTINATION_NATS_AUTHENTICATED=false
DESTINATION_NATS_CERTIFICATE_AUTHORITY_PATH=
DESTINATION_NATS_CLIENT_CERT_PATH=
DESTINATION_NATS_CLIENT_KEY_PATH=
